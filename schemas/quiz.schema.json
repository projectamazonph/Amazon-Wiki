{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "topic_tag",
    "difficulty",
    "question",
    "options",
    "correct_answer",
    "explanation"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "topic_tag": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "Foundational",
        "Applied",
        "Advanced"
      ]
    },
    "question": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correct_answer": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    }
  }
}
